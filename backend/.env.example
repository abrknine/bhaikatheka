# Copy to .env and fill in. Never commit .env.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=generate-me-see-readme
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Kolkata
DJANGO_LOG_LEVEL=INFO

# sqlite by default; swap for postgres in any real environment
# DATABASE_URL=postgres://theka:theka@localhost:5432/theka

# Origins allowed to call this API (your game's URL)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://bhaikatheka.vercel.app
CSRF_TRUSTED_ORIGINS=https://bhaikatheka.vercel.app

JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14
